{
  "name": "safetrack-cloud",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "e2e": "node tests/e2e/admin-flow.mjs && node tests/e2e/tellers-flow.mjs && node tests/e2e/giving-flow.mjs && node tests/e2e/etransfer-flow.mjs && node tests/e2e/mailbox-flow.mjs",
    "seed:demo": "node --env-file=.env scripts/seed-demo.mjs",
    "test:unit": "tsx tests/unit/giving.test.ts && tsx tests/unit/etransfer.test.ts && tsx tests/unit/mailbox.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.562.0",
    "multer": "^2.1.1",
    "nodemailer": "^10.5.0",
    "postal-mime": "^4.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.6.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "hoodiecrow-imap": "^3.3.1",
    "imapflow": "^2.11.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
